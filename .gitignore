# APEX AI - .gitignore
# Data directories - keep them out of git (large, reproducible from source)
01_Data_Raw/
02_Data_Processed/

# Python cache & build files
__pycache__/
*.pyc
*.pyo
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
env/
.venv/
ENV/

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary files
*.log
*.tmp
*.bak

# SQLite database
*.db
*.sqlite
*.sqlite3
*.f1.db

# Private Author Collateral (keep out of public repo)
08_Academic_Submission/
*outreach*
